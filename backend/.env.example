# AcademiaIQ Backend Environment Variables

# Server
PORT=3001
NODE_ENV=development

# CORS - comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173,https://your-vercel-app.vercel.app

# JWT Secret - CHANGE THIS IN PRODUCTION!
JWT_SECRET=academiaiq-dev-secret-change-in-production-min-32-chars

# Database path
DATABASE_PATH=./data/academiaiq.db
